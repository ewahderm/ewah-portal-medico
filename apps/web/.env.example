# Copia este archivo como .env.local y completa los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL base de la app (se usa para armar links de invitación/recuperación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — envío de correos a pacientes (cita agendada/actualizada/cancelada)
# https://resend.com/api-keys
RESEND_API_KEY=
# Remitente de esos correos. Si se deja vacío se usa el dominio de pruebas
# compartido de Resend (onboarding@resend.dev), que funciona pero tiende a
# caer en spam. Verificar un dominio propio en Resend y definirlo aquí,
# ej: RESEND_FROM_EMAIL="EWAH By Dra. Lorena Pinzón <citas@ewahclinic.com>"
RESEND_FROM_EMAIL=
